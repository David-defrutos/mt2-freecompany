  "character_triggers": [
    {
      "id": "RodericMusterTrigger",
      "trigger": "card_monster_played",
      "descriptions": {
        "english": "When a unit is summoned on this floor, it gains [effect0.status0.power] [armor] and this unit gains <b>+2</b> [attack] and <b>+2</b> [health] permanently.",
        "french": "Lorsqu’une unité est invoquée à cet étage, elle gagne [effect0.status0.power] [armor] et cette unité gagne définitivement <b>+2</b> [attack] et <b>+2</b> [health].",
        "german": "Wenn eine Einheit auf diesem Stockwerk beschworen wird, erhält sie [effect0.status0.power] [armor] und diese Einheit erhält dauerhaft <b>+2</b> [attack] und <b>+2</b> [health].",
        "russian": "Когда на этот этаж призывается боевая единица, она получает [effect0.status0.power] [armor], а эта боевая единица навсегда получает <b>+2</b> [attack] и <b>+2</b> [health].",
        "portuguese": "Quando uma unidade é invocada neste andar, ela ganha [effect0.status0.power] [armor] e esta unidade ganha <b>+2</b> [attack] e <b>+2</b> [health] permanentemente.",
        "chinese": "一个单位在本层被召唤时，该单位获得[effect0.status0.power]层[armor]，此单位永久获得<b>+2</b> [attack]和<b>+2</b> [health]。",
        "spanish": "Cuando se invoca una unidad en este piso, gana [effect0.status0.power] [armor] y esta unidad gana <b>+2</b> [attack] y <b>+2</b> [health] permanentemente.",
        "chinese_traditional": "一個單位在本層被召喚時，該單位獲得[effect0.status0.power]層[armor]，此單位永久獲得<b>+2</b> [attack]和<b>+2</b> [health]。",
        "korean": "이 층에 유닛이 소환되면 해당 유닛은 [effect0.status0.power] [armor] 획득. 이 유닛은 영구적으로 <b>+2</b> [attack] 및 <b>+2</b> [health] 획득.",
        "japanese": "この階にユニットが召喚されると、そのユニットは[effect0.status0.power] [armor]を得て、このユニットは永続的に<b>+2</b> [attack]と<b>+2</b> [health]を得る。"
      },
      "effects": [
        "@RodericMusterGate",
        "@RodericMusterBuff"
      ]
    }
