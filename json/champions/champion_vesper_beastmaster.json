{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "BeastmasterCall",
      "names": {
        "english": "Call of the Wild"
      },
      "descriptions": {
        "english": "Put a <b>Troll</b> in your hand. It costs <b>0</b> [ember]."
      },
      "card_art": "@Vesper",
      "is_an_ability": true,
      "cooldown": 4,
      "initial_cooldown": 4,
      "targetless": true,
      "targets_room": false,
      "card_type": "spell",
      "effects": [
        "@BeastmasterCallGate",
        "@BeastmasterCallFromDraw",
        "@BeastmasterCallFromDiscard",
        "@BeastmasterCallZero"
      ]
    },
    {
      "id": "BeastmasterCall3",
      "names": {
        "english": "Call of the Wild"
      },
      "descriptions": {
        "english": "Put a <b>Troll</b> in your hand. It costs <b>0</b> [ember]."
      },
      "card_art": "@Vesper",
      "is_an_ability": true,
      "cooldown": 4,
      "initial_cooldown": 3,
      "targetless": true,
      "targets_room": false,
      "card_type": "spell",
      "effects": [
        "@BeastmasterCallGate",
        "@BeastmasterCallFromDraw",
        "@BeastmasterCallFromDiscard",
        "@BeastmasterCallZero"
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "BeastmasterGrantTrigger",
      "trigger": "pre_combat",
      "descriptions": {
        "english": "The first time, <b>3</b> random <b>Tame</b> spells join your hand. The one you play keeps that <b>Troll</b> for the run."
      },
      "effects": [
        "@BeastmasterOffer"
      ]
    }
  ],
  "effects": [
    {
      "id": "BeastmasterOffer",
      "name": "@CardEffectOfferRandomFromPool",
      "target_mode": "pyre",
      "target_team": "monsters",
      "param_card_pool": "@FreeCompanyTameOffersPool",
      "param_subtype": "@Sub_Troll",
      "param_int": 3
    },
    {
      "id": "BeastmasterCallGate",
      "name": "@CardEffectIfSubtypeInDrawPile",
      "param_subtype": "@Sub_Troll",
      "target_mode": "self",
      "target_team": "monsters",
      "should_test": true,
      "should_fail_to_cast_if_test_fails": true,
      "should_cancel_subsequent_effects_if_test_fails": true
    },
    {
      "id": "BeastmasterCallFromDraw",
      "name": "CardEffectRecursion",
      "target_mode": "draw_pile",
      "target_card_selection_mode": "random_to_hand",
      "target_card_type": "monster",
      "target_subtype": "@Sub_Troll",
      "param_int": 1,
      "should_test": true,
      "should_fail_to_cast_if_test_fails": false,
      "should_cancel_subsequent_effects_if_test_fails": false
    },
    {
      "id": "BeastmasterCallFromDiscard",
      "name": "CardEffectRecursion",
      "target_mode": "discard",
      "target_card_selection_mode": "random_to_hand",
      "target_card_type": "monster",
      "target_subtype": "@Sub_Troll",
      "param_int": 1,
      "should_test": true,
      "should_fail_to_cast_if_test_fails": false,
      "should_cancel_subsequent_effects_if_test_fails": false
    },
    {
      "id": "BeastmasterCallZero",
      "name": "CardEffectAddTempCardUpgradeToCardsInHand",
      "target_mode": "pyre",
      "target_team": "monsters",
      "param_upgrade": "@TrollFreeSummon",
      "should_test": false
    }
  ],
  "upgrade_masks": [
    {
      "id": "TrollOnlyMask",
      "card_type": "monster",
      "cost_range": {
        "x": 0,
        "y": 99
      },
      "required_subtypes": [
        "@Sub_Troll"
      ]
    }
  ],
  "upgrades": [
    {
      "id": "TrollFreeSummon",
      "cost_reduction": 6,
      "filters": [
        "@TrollOnlyMask"
      ]
    },
    {
      "id": "upg_Beastmaster1",
      "titles": {
        "english": "Beastmaster"
      },
      "descriptions": {
        "english": "Vesper arrives with a tamed <b>Troll</b>.\nTrolls: +<b>10</b> [attack]/[health] per Ring after the first."
      },
      "bonus_hp": 6,
      "trigger_upgrades": [
        "@BeastmasterGrantTrigger"
      ],
      "ability_upgrade": "@BeastmasterCall"
    },
    {
      "id": "upg_Beastmaster2",
      "titles": {
        "english": "Beastmaster II"
      },
      "descriptions": {
        "english": "Trolls: +<b>10</b> [attack]/[health] per Ring after the first, and [trample]."
      },
      "bonus_hp": 12,
      "bonus_damage": 4,
      "remove_upgrades": [
        "@upg_Beastmaster1"
      ],
      "trigger_upgrades": [
        "@BeastmasterGrantTrigger"
      ],
      "ability_upgrade": "@BeastmasterCall"
    },
    {
      "id": "upg_Beastmaster3",
      "titles": {
        "english": "Beastmaster III"
      },
      "descriptions": {
        "english": "Trolls: +<b>10</b> [attack]/[health] per Ring after the first, and [trample].\n<b>Call of the Wild</b> is ready a turn sooner."
      },
      "bonus_hp": 18,
      "bonus_damage": 8,
      "remove_upgrades": [
        "@upg_Beastmaster2"
      ],
      "trigger_upgrades": [
        "@BeastmasterGrantTrigger"
      ],
      "ability_upgrade": "@BeastmasterCall3"
    },
    {
      "id": "TrollOffer",
      "titles": {
        "english": "Beastmaster"
      },
      "trait_upgrades": [
        "@TrollOfferEphemeral"
      ],
      "hide_icon_on_card": true
    }
  ],
  "traits": [
    {
      "id": "TrollOfferEphemeral",
      "name": "CardTraitEphemeral"
    }
  ]
}
