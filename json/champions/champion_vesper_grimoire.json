{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "GrimoireSpell1",
      "names": {
        "english": "Prepare Spell I"
      },
      "descriptions": {
        "english": "Add a random <b>Common</b> spell to your hand. It costs <b>0</b> [ember] and is [ephemeral]."
      },
      "card_art": "@Vesper",
      "is_an_ability": true,
      "cooldown": 2,
      "initial_cooldown": 2,
      "targetless": true,
      "targets_room": false,
      "card_type": "spell",
      "effects": [
        "@GrimoireDraw1"
      ]
    },
    {
      "id": "GrimoireSpell2",
      "names": {
        "english": "Prepare Spell II"
      },
      "descriptions": {
        "english": "Add a random <b>Common</b> or <b>Uncommon</b> spell to your hand. It costs <b>0</b> [ember] and is [ephemeral]."
      },
      "card_art": "@Vesper",
      "is_an_ability": true,
      "cooldown": 2,
      "initial_cooldown": 2,
      "targetless": true,
      "targets_room": false,
      "card_type": "spell",
      "effects": [
        "@GrimoireDraw2"
      ]
    },
    {
      "id": "GrimoireSpell3",
      "names": {
        "english": "Prepare Spell III"
      },
      "descriptions": {
        "english": "Add a random spell to your hand. It costs <b>0</b> [ember] and is [ephemeral]."
      },
      "card_art": "@Vesper",
      "is_an_ability": true,
      "cooldown": 2,
      "initial_cooldown": 2,
      "targetless": true,
      "targets_room": false,
      "card_type": "spell",
      "effects": [
        "@GrimoireDraw3"
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "GrimoireStarterTrigger",
      "trigger": "pre_combat",
      "descriptions": {
        "english": "Add a <b>Magic Missile</b> to your hand. It costs <b>0</b> [ember] and is [ephemeral]."
      },
      "effects": [
        "@GrimoireStarterCard"
      ]
    },
    {
      "id": "GrimoireCelebrate",
      "trigger": "on_encounter_complete",
      "descriptions": {
        "english": "Gain <b>2</b> [conduit] permanently."
      },
      "effects": [
        "@GrimoireCelebrateGain"
      ]
    }
  ],
  "effects": [
    {
      "id": "GrimoireStarterCard",
      "name": "CardEffectAddBattleCard",
      "param_card_pool": "@FreeCompanyMagicMissilePool",
      "param_int": 3,
      "param_int_2": 1,
      "param_upgrade": "@GrimoireFreeSpell"
    },
    {
      "id": "GrimoireDraw1",
      "name": "CardEffectAddBattleCard",
      "param_card_pool": "@FreeCompanySpellsCommonPool",
      "param_int": 3,
      "param_int_2": 1,
      "param_upgrade": "@GrimoireFreeSpell"
    },
    {
      "id": "GrimoireDraw2",
      "name": "CardEffectAddBattleCard",
      "param_card_pool": "@FreeCompanySpellsUncommonPool",
      "param_int": 3,
      "param_int_2": 1,
      "param_upgrade": "@GrimoireFreeSpell"
    },
    {
      "id": "GrimoireDraw3",
      "name": "CardEffectAddBattleCard",
      "param_card_pool": "@FreeCompanySpellsAllPool",
      "param_int": 3,
      "param_int_2": 1,
      "param_upgrade": "@GrimoireFreeSpell"
    },
    {
      "id": "GrimoireCelebrateGain",
      "name": "CardEffectAddCardUpgradeToUnits",
      "target_mode": "self",
      "target_team": "monsters",
      "param_upgrade": "@GrimoireCelebrateUpgrade",
      "param_int_3": 2
    }
  ],
  "upgrades": [
    {
      "id": "upg_Grimoire1",
      "titles": {
        "english": "Grimoire"
      },
      "descriptions": {
        "english": "Free spells, every turn."
      },
      "bonus_damage": 4,
      "trigger_upgrades": [
        "@GrimoireStarterTrigger",
        "@GrimoireCelebrate"
      ],
      "ability_upgrade": "@GrimoireSpell1"
    },
    {
      "id": "upg_Grimoire2",
      "titles": {
        "english": "Grimoire II"
      },
      "descriptions": {
        "english": "Free spells, every turn."
      },
      "bonus_damage": 10,
      "remove_upgrades": [
        "@upg_Grimoire1"
      ],
      "trigger_upgrades": [
        "@GrimoireStarterTrigger",
        "@GrimoireCelebrate"
      ],
      "ability_upgrade": "@GrimoireSpell2"
    },
    {
      "id": "upg_Grimoire3",
      "titles": {
        "english": "Grimoire III"
      },
      "descriptions": {
        "english": "Free spells, every turn."
      },
      "bonus_damage": 18,
      "remove_upgrades": [
        "@upg_Grimoire2"
      ],
      "trigger_upgrades": [
        "@GrimoireStarterTrigger",
        "@GrimoireCelebrate"
      ],
      "ability_upgrade": "@GrimoireSpell3"
    },
    {
      "id": "GrimoireFreeSpell",
      "titles": {
        "english": "Grimoire"
      },
      "cost_reduction": 4,
      "trait_upgrades": [
        "@GrimoireEphemeralTrait"
      ],
      "hide_icon_on_card": true
    },
    {
      "id": "GrimoireCelebrateUpgrade",
      "status_effect_upgrades": [
        {
          "status": "conduit",
          "count": 2
        }
      ]
    }
  ],
  "traits": [
    {
      "id": "GrimoireEphemeralTrait",
      "name": "CardTraitEphemeral"
    }
  ]
}
