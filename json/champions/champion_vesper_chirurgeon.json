  "character_triggers": [
    {
      "id": "ChirurgeonTrigger1",
      "trigger": "pre_combat",
      "descriptions": {
        "english": "Restore [effect0.power] health to all allies here. Cleanse <b>1</b> random debuffed ally here.",
        "french": "Rendez [effect0.power] PV à tous les alliés ici. Purifiez <b>1</b> allié aléatoire affecté par des malus ici.",
        "german": "Heile alle Verbündeten hier um [effect0.power] Leben. Entferne Schwächungen von <b>1</b> zufälligen geschwächten Verbündeten hier.",
        "russian": "Восстановите [effect0.power] здоровья всем союзникам здесь. Очистите <b>1</b> случайных союзников с ослаблениями здесь.",
        "portuguese": "Restaure [effect0.power] de vida de todos os aliados aqui. Purifique <b>1</b> aliado aleatório com penalidades aqui.",
        "chinese": "为本层所有友军恢复[effect0.power]点生命值。随机净化本层<b>1</b>个带有减益的友军。",
        "spanish": "Restaura [effect0.power] de vida a todos los aliados de aquí. Limpia <b>1</b> aliado aleatorio con perjuicios aquí.",
        "chinese_traditional": "為本層所有友軍恢復[effect0.power]點生命值。隨機淨化本層<b>1</b>個帶有減益的友軍。",
        "korean": "이 층의 모든 아군의 체력을 [effect0.power] 회복. 이 층의 약화 효과가 있는 무작위 아군 <b>1</b>명을 정화.",
        "japanese": "この階の味方全体の体力を[effect0.power]回復。この階の弱体効果を受けているランダムな味方<b>1</b>体を浄化。"
      },
      "effects": [
        "@ChirurgeonHeal1",
        "@ChirurgeonCleanse1_1"
      ]
    },
