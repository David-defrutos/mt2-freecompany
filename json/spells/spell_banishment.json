{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "Banishment",
      "names": {
        "english": "Banishment"
      },
      "descriptions": {
        "english": "Apply <b>[effect0.status0.power]</b> [mt2_freecompany.Plugin_banished] to an enemy. Cannot target bosses."
      },
      "card_art": "@Banishment",
      "cost": 3,
      "card_type": "spell",
      "rarity": "rare",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@BanishmentPlant",
        "@BanishmentTicker"
      ],
      "lore_tooltips": [
        {
          "english": "Sent somewhere else. Not invited back."
        }
      ],
      "pools": [
        "MegaPool"
      ]
    }
  ],
  "effects": [
    {
      "id": "BanishmentPlant",
      "name": "@CardEffectPlantCountdown",
      "target_mode": "drop_target_character",
      "target_team": "heroes",
      "target_ignore_bosses": true,
      "param_int": 9999,
      "param_status_effects": [
        {
          "status": "@banished",
          "count": 2
        }
      ]
    },
    {
      "id": "BanishmentTicker",
      "target_ignore_bosses": true,
      "name": "CardEffectAddTempCardUpgradeToUnits",
      "target_mode": "drop_target_character",
      "target_team": "heroes",
      "param_upgrade": "@CountdownTicker",
      "param_int_3": 0
    }
  ],
  "sprites": [
    {
      "id": "Banishment",
      "path": "textures/BanishmentArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "Banishment",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@Banishment"
        }
      }
    }
  ]
}