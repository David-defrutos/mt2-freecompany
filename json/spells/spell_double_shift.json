{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "DoubleShift",
      "names": {
        "english": "Double Shift"
      },
      "descriptions": {
        "english": "The unit attacks immediately. At the start of next turn, it gains <b>1</b> [dazed]."
      },
      "card_art": "@DoubleShift",
      "cost": 1,
      "card_type": "spell",
      "rarity": "uncommon",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@DoubleShiftStrike",
        "@DoubleShiftMark"
      ],
      "lore_tooltips": [
        {
          "english": "Overtime rates apply."
        }
      ],
      "pools": [
        "MegaPool"
      ]
    }
  ],
  "effects": [
    {
      "id": "DoubleShiftStrike",
      "name": "CardEffectAttackWithUnit",
      "target_mode": "drop_target_character",
      "target_team": "monsters"
    },
    {
      "id": "DoubleShiftMark",
      "name": "CardEffectAddTempCardUpgradeToUnits",
      "target_mode": "drop_target_character",
      "target_team": "monsters",
      "param_upgrade": "@DoubleShiftOvertime",
      "param_int_3": 0
    },
    {
      "id": "DoubleShiftDaze",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "dazed",
          "count": 1
        }
      ]
    }
  ],
  "upgrades": [
    {
      "id": "DoubleShiftOvertime",
      "titles": {
        "english": "Overtime"
      },
      "descriptions": {
        "english": "At the start of next turn, gain <b>1</b> [dazed]."
      },
      "trigger_upgrades": [
        "@DoubleShiftOvertimeTrigger"
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "DoubleShiftOvertimeTrigger",
      "trigger": "pre_combat",
      "descriptions": {
        "english": "Gain <b>1</b> [dazed]."
      },
      "effects": [
        "@DoubleShiftDaze"
      ],
      "trigger_once": true
    }
  ],
  "sprites": [
    {
      "id": "DoubleShift",
      "path": "textures/DoubleShiftArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "DoubleShift",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@DoubleShift"
        }
      }
    }
  ]
}