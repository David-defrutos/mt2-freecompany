{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "Resurrection",
      "names": {
        "english": "Resurrection"
      },
      "descriptions": {
        "english": "Apply [effect0.status0.power] [undying] and [effect1.status0.power] [regen] to a friendly unit."
      },
      "card_art": "@Resurrection",
      "cost": 2,
      "card_type": "spell",
      "rarity": "rare",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@ResurrectionUndying",
        "@ResurrectionRegen"
      ],
      "lore_tooltips": [
        {
          "english": "The contract does not end at death."
        }
      ],
      "pools": [
        "MegaPool"
      ]
    }
  ],
  "effects": [
    {
      "id": "ResurrectionUndying",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "drop_target_character",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "undying",
          "count": 1
        }
      ]
    },
    {
      "id": "ResurrectionRegen",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "drop_target_character",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "regen",
          "count": 10
        }
      ]
    }
  ],
  "sprites": [
    {
      "id": "Resurrection",
      "path": "textures/ResurrectionArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "Resurrection",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@Resurrection"
        }
      }
    }
  ]
}