{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "DelayedBlastFireball",
      "names": {
        "english": "Delayed Blast Fireball"
      },
      "descriptions": {
        "english": "Apply <b>[effect0.status0.power]</b> [mt2_freecompany.Plugin_fuse] to an enemy. When it runs out, deal <b>[effect0.power]</b> damage to it."
      },
      "card_art": "@DelayedBlastFireball",
      "cost": 3,
      "card_type": "spell",
      "rarity": "rare",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@DelayedFusePlant",
        "@DelayedFuseTicker"
      ],
      "lore_tooltips": [
        {
          "english": "Count with me."
        }
      ],
      "pools": [
        "MegaPool"
      ],
      "traits": [
        "@DelayedExplosive"
      ]
    }
  ],
  "effects": [
    {
      "id": "DelayedFusePlant",
      "name": "@CardEffectPlantCountdown",
      "target_mode": "drop_target_character",
      "target_team": "heroes",
      "param_int": 100,
      "param_status_effects": [
        {
          "status": "@fuse",
          "count": 2
        }
      ]
    },
    {
      "id": "DelayedFuseTicker",
      "name": "CardEffectAddTempCardUpgradeToUnits",
      "target_mode": "drop_target_character",
      "target_team": "heroes",
      "param_upgrade": "@CountdownTicker",
      "param_int_3": 0
    }
  ],
  "sprites": [
    {
      "id": "DelayedBlastFireball",
      "path": "textures/DelayedBlastFireballArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "DelayedBlastFireball",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@DelayedBlastFireball"
        }
      }
    }
  ],
  "traits": [
    {
      "id": "DelayedExplosive",
      "name": "CardTraitDamageOverflow",
      "param_int": 2
    }
  ]
}