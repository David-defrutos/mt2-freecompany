{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "relic_effects": [
    {
      "id": "HazardPayEffect",
      "name": "RelicEffectAddTempUpgradeOnGoldThreshold",
      "param_int": 300,
      "param_card_type": "monster",
      "param_upgrade": "@HazardPayBonus"
    }
  ],
  "relics": [
    {
      "id": "HazardPay",
      "type": "collectable",
      "names": {
        "english": "Hazard Pay"
      },
      "descriptions": {
        "english": "While you have <b>300</b> or more [coin], unit cards get <b>+3</b> [attack] and <b>+5</b> [health]."
      },
      "relic_activated_texts": {
        "english": "Rates have gone up."
      },
      "lore_tooltips": [
        {
          "english": "The worse the contract, the better the terms."
        }
      ],
      "lore_style": "herzal",
      "relic_effects": [
        "@HazardPayEffect"
      ],
      "icon": "@HazardPayIcon",
      "icon_small": "@HazardPayIconSmall",
      "extensions": [
        {
          "collectable": {
            "class": "@ClassFreeCompany",
            "pools": [
              "MegaRelicPool"
            ],
            "rarity": "rare"
          }
        }
      ]
    }
  ],
  "sprites": [
    {
      "id": "HazardPayIcon",
      "path": "textures/HazardPayIcon.png"
    },
    {
      "id": "HazardPayIconSmall",
      "path": "textures/HazardPayIconSmall.png"
    }
  ],
  "upgrades": [
    {
      "id": "HazardPayBonus",
      "titles": {
        "english": "Hazard Pay"
      },
      "bonus_damage": 3,
      "bonus_hp": 5,
      "hide_icon_on_card": true
    }
  ]
}