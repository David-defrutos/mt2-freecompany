{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnFieldMedic",
      "names": {
        "english": "Field Medic"
      },
      "card_art": "@FieldMedic",
      "cost": 1,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnFieldMedicEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Keeps a tally of who still owes her."
        }
      ],
      "pools": [
        "UnitsAllBanner"
      ]
    }
  ],
  "characters": [
    {
      "id": "FieldMedic",
      "names": {
        "english": "Field Medic"
      },
      "character_art": "@FieldMedicCharacterArt",
      "size": 1,
      "attack_damage": 3,
      "health": 18,
      "subtypes": [
        "SubtypesData_BannerUnit",
        "@Sub_Ranged",
        "@Sub_Cleric",
        "@Sub_Goblin"
      ],
      "triggers": [
        {
          "id": "@FieldMedicEndTrigger"
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnFieldMedicEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@FieldMedic"
    },
    {
      "id": "FieldMedicHeal",
      "name": "CardEffectHeal",
      "target_mode": "weakest",
      "target_team": "monsters",
      "param_int": 4
    },
    {
      "id": "FieldMedicCleanse",
      "name": "CardEffectRemoveAllStatusEffects",
      "target_mode": "random_in_room",
      "target_team": "monsters",
      "param_int": 1,
      "param_bool": false,
      "target_mode_status_effects_filter": [
        {
          "status": "corrupt_poison"
        },
        {
          "status": "corruption"
        },
        {
          "status": "dazed"
        },
        {
          "status": "debuff"
        },
        {
          "status": "decay"
        },
        {
          "status": "doom"
        },
        {
          "status": "heal immunity"
        },
        {
          "status": "malaise"
        },
        {
          "status": "melee weakness"
        },
        {
          "status": "muted"
        },
        {
          "status": "poison"
        },
        {
          "status": "pyregel"
        },
        {
          "status": "pyrestain"
        },
        {
          "status": "rooted"
        },
        {
          "status": "scorch"
        },
        {
          "status": "spell weakness"
        },
        {
          "status": "timebomb"
        },
        {
          "status": "unstable"
        },
        {
          "status": "witherbloom"
        }
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "FieldMedicEndTrigger",
      "trigger": "pre_combat",
      "descriptions": {
        "english": "Restore [effect0.power] health to the weakest friendly unit and remove all debuffs from a random debuffed friendly unit."
      },
      "effects": [
        "@FieldMedicHeal",
        "@FieldMedicCleanse"
      ]
    }
  ],
  "sprites": [
    {
      "id": "FieldMedic",
      "path": "textures/FieldMedicCardArt.png"
    },
    {
      "id": "FieldMedicCharacterArt",
      "path": "textures/FieldMedicCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "FieldMedic",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@FieldMedic"
        }
      }
    },
    {
      "id": "FieldMedicCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@FieldMedicCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 0.517,
              "z": 0
            },
            "scale": {
              "x": 0.733,
              "y": 0.733,
              "z": 1
            }
          }
        }
      }
    }
  ]
}