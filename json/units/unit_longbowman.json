{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnLongbowman",
      "names": {
        "english": "Longbowman"
      },
      "card_art": "@Longbowman",
      "cost": 2,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnLongbowmanEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Aims past the noise at the back of the room."
        }
      ],
      "pools": [
        "UnitsAllBanner"
      ]
    },
    {
      "id": "LongbowmanShiftAim",
      "names": {
        "english": "Shift Aim"
      },
      "descriptions": {
        "english": "This unit loses <b>Sniper</b> until the start of your next turn, and attacks the front enemy instead."
      },
      "card_art": "@Longbowman",
      "is_an_ability": true,
      "cooldown": 1,
      "targetless": true,
      "targets_room": false,
      "card_type": "spell",
      "effects": [
        "@LongbowmanSniperOff"
      ]
    }
  ],
  "characters": [
    {
      "id": "Longbowman",
      "names": {
        "english": "Longbowman"
      },
      "character_art": "@LongbowmanCharacterArt",
      "size": 1,
      "attack_damage": 8,
      "health": 10,
      "subtypes": [
        "SubtypesData_BannerUnit",
        "@Sub_Ranged",
        "@Sub_Ranger",
        "@Sub_Goblin"
      ],
      "starting_status_effects": [
        {
          "status": "sniper",
          "count": 1
        },
        {
          "status": "multistrike",
          "count": 1
        }
      ],
      "ability": "@LongbowmanShiftAim",
      "triggers": [
        {
          "id": "@LongbowmanSniperBack"
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnLongbowmanEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@Longbowman"
    },
    {
      "id": "LongbowmanSniperOff",
      "name": "CardEffectRemoveStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "sniper",
          "count": 1
        }
      ]
    },
    {
      "id": "LongbowmanSniperOn",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "sniper",
          "count": 1
        }
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "LongbowmanSniperBack",
      "trigger": "on_team_turn_begin",
      "descriptions": {
        "english": "Regain <b>Sniper</b>."
      },
      "effects": [
        "@LongbowmanSniperOn"
      ]
    }
  ],
  "sprites": [
    {
      "id": "Longbowman",
      "path": "textures/LongbowmanCardArt.png"
    },
    {
      "id": "LongbowmanCharacterArt",
      "path": "textures/LongbowmanCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "Longbowman",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@Longbowman"
        }
      }
    },
    {
      "id": "LongbowmanCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@LongbowmanCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 0.523,
              "z": 0
            },
            "scale": {
              "x": 0.585,
              "y": 0.585,
              "z": 1
            }
          }
        }
      }
    }
  ]
}
