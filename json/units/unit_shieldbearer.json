      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "armor",
          "count": 5
        }
      ]
    },
    {
      "id": "ShieldbearerAbilityBlast",
      "name": "CardEffectDamagePerHp",
      "target_mode": "self",
      "target_team": "monsters",
      "param_int": 2
    },
    {
      "id": "ShieldbearerAbilityRecoil",
      "name": "CardEffectDamageByPercentRemainingHealth",
      "target_mode": "self",
      "target_team": "monsters",
      "param_int": 50
    }
  ],
  "character_triggers": [
    {
      "id": "ShieldbearerSpawnTrigger",
      "trigger": "on_spawn",
      "descriptions": {
        "english": "Apply [effect0.status0.power] [armor] to itself.",
        "french": "S’applique [effect0.status0.power] [armor].",
        "german": "Erhält selbst [effect0.status0.power] [armor].",
        "russian": "Накладывает на себя [effect0.status0.power] [armor].",
        "portuguese": "Aplica [effect0.status0.power] [armor] a si mesma.",
        "chinese": "对自身施加[effect0.status0.power] [armor]。",
        "spanish": "Se aplica [effect0.status0.power] [armor].",
        "chinese_traditional": "對自身施加[effect0.status0.power] [armor]。",
        "korean": "자신에게 [effect0.status0.power] [armor] 부여.",
        "japanese": "自身に[effect0.status0.power] [armor]を付与。"
      },
      "effects": [
        "@ShieldbearerArmor"
      ]
    }
