{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnShieldbearer",
      "names": {
        "english": "Shieldbearer",
        "french": "Porte-bouclier",
        "german": "Schildträger",
        "russian": "Щитоносец",
        "portuguese": "Porta-Escudo",
        "chinese": "持盾卫士",
        "spanish": "Portador de escudo",
        "chinese_traditional": "持盾衛士",
        "korean": "방패병",
        "japanese": "盾兵"
      },
      "card_art": "@Shieldbearer",
      "cost": 2,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnShieldbearerEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Paid to stand still and be hit.",
          "french": "Payé pour rester immobile et être frappé.",
          "german": "Sie werden bezahlt, um still zu stehen und getroffen zu werden.",
          "russian": "Заплатили за то, чтобы стоять неподвижно и получать удар.",
          "portuguese": "Pagado por ficar parado e ser atingido.",
          "chinese": "付钱站着,被击中.",
          "spanish": "Le pagan por quedarse quieto y recibir golpes.",
          "chinese_traditional": "付出錢來停下來被打.",
          "korean": "가만히 서서 타당하기 위해 돈을 받았어요.",
          "japanese": "止まって 撃たれるために支払った"
        }
      ],
      "pools": [
        "UnitsAllBanner"
      ]
    },
    {
      "id": "ShieldbearerAbility",
      "names": {
        "english": "Last Stand",
        "french": "Dernier rempart",
        "german": "Letztes Gefecht",
        "russian": "Последний бой",
        "portuguese": "Última Resistência",
        "chinese": "背水一战",
        "spanish": "Última resistencia",
        "chinese_traditional": "背水一戰",
        "korean": "최후의 저항",
        "japanese": "最後の抵抗"
      },
      "descriptions": {
        "english": "Deal damage to the enemy in front equal to twice this unit's [health]. Then this unit loses half its remaining [health].",
        "french": "Inflige à l’ennemi de tête des dégâts égaux au double de la [health] de cette unité. Elle perd ensuite la moitié de sa [health] restante.",
        "german": "Fügt dem vordersten Gegner Schaden in Höhe der doppelten [health] dieser Einheit zu. Danach verliert sie die Hälfte ihrer verbleibenden [health].",
        "russian": "Наносит переднему врагу урон, равный удвоенному [health] этой боевой единицы. Затем она теряет половину оставшегося [health].",
        "portuguese": "Causa dano ao inimigo da frente igual ao dobro da [health] desta unidade. Depois, ela perde metade da [health] restante.",
        "chinese": "对最前方的敌人造成相当于此单位[health]两倍的伤害。随后，此单位失去一半剩余[health]。",
        "spanish": "Inflige al primer enemigo un daño igual al doble de la [health] de esta unidad. Después, esta unidad pierde la mitad de su [health] restante.",
        "chinese_traditional": "對最前方的敵人造成相當於此單位[health]兩倍的傷害。隨後，此單位失去一半剩餘[health]。",
        "korean": "맨 앞 적에게 이 유닛의 [health] 두 배만큼 피해를 가함. 이후 이 유닛은 남은 [health]의 절반을 잃음.",
        "japanese": "先頭の敵にこのユニットの[health]の2倍のダメージを与える。その後、このユニットは残り[health]の半分を失う。"
      },
      "card_art": "@Shieldbearer",
      "is_an_ability": true,
      "cooldown": 2,
      "targetless": true,
      "targets_room": false,
      "card_type": "spell",
      "effects": [
        "@ShieldbearerAbilityBlast",
        "@ShieldbearerAbilityRecoil"
      ]
    }
  ],
  "characters": [
    {
      "id": "Shieldbearer",
      "names": {
        "english": "Shieldbearer",
        "french": "Porte-bouclier",
