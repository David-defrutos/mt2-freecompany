{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnHedgeConjurer",
      "names": {
        "english": "Hedge Conjurer"
      },
      "card_art": "@HedgeConjurer",
      "cost": 2,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnHedgeConjurerEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Self-taught, and it shows. Still cheaper than a guild mage."
        }
      ],
      "pools": [
        "MegaPool"
      ]
    },
    {
      "id": "ConjurerVolatile",
      "names": {
        "english": "Volatile Reagents"
      },
      "descriptions": {
        "english": "Draw a damage spell. It becomes <b>Explosive</b>."
      },
      "rarity": "common",
      "card_art": "@HedgeConjurer",
      "is_an_ability": true,
      "cooldown": 5,
      "initial_cooldown": 4,
      "targetless": true,
      "card_type": "spell",
      "effects": [
        "@ConjurerVolatileMark",
        "@ConjurerVolatileDraw"
      ],
      "initial_keyboard_target": "front_friendly"
    }
  ],
  "characters": [
    {
      "id": "HedgeConjurer",
      "names": {
        "english": "Hedge Conjurer"
      },
      "character_art": "@HedgeConjurerCharacterArt",
      "size": 1,
      "attack_damage": 5,
      "health": 12,
      "subtypes": [
        "SubtypesData_BannerUnit",
        "@Sub_Ranged",
        "@Sub_Wizard",
        "@Sub_Goblin"
      ],
      "starting_status_effects": [
        {
          "status": "mageblade",
          "count": 2
        }
      ],
      "triggers": [
        {
          "id": "@HedgeConjurerTrigger"
        }
      ],
      "ability": "@ConjurerVolatile"
    }
  ],
  "effects": [
    {
      "id": "SpawnHedgeConjurerEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@HedgeConjurer"
    },
    {
      "id": "HedgeConjurerAbility",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "conduit",
          "count": 1
        }
      ]
    },
    {
      "id": "ConjurerVolatileMark",
      "name": "CardEffectAddTempCardUpgradeToNextDrawnCard",
      "param_upgrade": "@ExplosiveSpell"
    },
    {
      "id": "ConjurerVolatileDraw",
      "name": "CardEffectDrawType",
      "param_card_filter": "@DamageSpellMask",
      "param_int": 1
    }
  ],
  "character_triggers": [
    {
      "id": "HedgeConjurerTrigger",
      "trigger": "card_spell_played",
      "descriptions": {
        "english": "Gain [effect0.status0.power] [conduit]."
      },
      "effects": [
        "@HedgeConjurerAbility"
      ]
    }
  ],
  "sprites": [
    {
      "id": "HedgeConjurer",
      "path": "textures/HedgeConjurerCardArt.png"
    },
    {
      "id": "HedgeConjurerCharacterArt",
      "path": "textures/HedgeConjurerCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "HedgeConjurer",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@HedgeConjurer"
        }
      }
    },
    {
      "id": "HedgeConjurerCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@HedgeConjurerCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 0.477,
              "z": 0
            },
            "scale": {
              "x": 0.623,
              "y": 0.623,
              "z": 1
            }
          }
        }
      }
    }
  ],
  "upgrade_masks": [
    {
      "id": "DamageSpellMask",
      "card_type": "spell",
      "cost_range": {
        "x": 0,
        "y": 99
      },
      "required_effects": [
        "CardEffectDamage",
        "CardEffectDamageByPercentRemainingHealth",
        "CardEffectDamageByUnitsKilled",
        "CardEffectDamagePerHp",
        "CardEffectDamagePerSourceAttack",
        "CardEffectDamagePerTargetAttack",
        "CardEffectDamageWithTrample",
        "CardEffectHealAndDamageRelative"
      ],
      "required_effects_operator": "or"
    }
  ],
  "upgrades": [
    {
      "id": "ExplosiveSpell",
      "titles": {
        "english": "Volatile"
      },
      "trait_upgrades": [
        "@ExplosiveOverflow"
      ]
    }
  ],
  "traits": [
    {
      "id": "ExplosiveOverflow",
      "name": "CardTraitDamageOverflow",
      "param_int": 2
    }
  ]
}
