  "cards": [
    {
      "id": "SpawnHedgeConjurer",
      "names": {
        "english": "Hedge Conjurer",
        "french": "Invocateur autodidacte",
        "german": "Heckenbeschwörer",
        "russian": "Самоучка-заклинатель",
