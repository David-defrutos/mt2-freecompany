      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnHedgeConjurerEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Self-taught, and it shows. Still cheaper than a guild mage.",
          "french": "Autodidacte, et ça se voit. C'est toujours moins cher qu'un magicien de guilde.",
          "german": "Selbstunterricht, und das zeigt sich. Noch billiger als ein Gilde-Magier.",
          "russian": "Самоученный, и это видно. Все еще дешевле, чем волшебник гильдии.",
          "portuguese": "Autodidacta, e mostra-se. Ainda é mais barato do que um mago da guilda.",
          "chinese": "他自学了,这就显而易见. 还比一个协会魔术师便宜.",
          "spanish": "Autodidacta, y se nota. Aun así, más barato que un mago del gremio.",
          "chinese_traditional": "這樣就顯示了. 還是比一個協會魔術師便宜.",
          "korean": "자율적으로 배웠습니다. 릴드 마그보다 더 저렴해요",
          "japanese": "自分で教えたと分かった まだギルドの魔法使いより安い"
        }
      ],
      "pools": [
        "MegaPool"
      ]
    },
    {
      "id": "ConjurerVolatile",
