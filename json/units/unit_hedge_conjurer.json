        "chinese_traditional": "不穩定試劑",
        "korean": "불안정한 시약",
        "japanese": "不安定な試薬"
      },
      "descriptions": {
        "english": "Draw a damage spell. It becomes <b>Explosive</b>.",
        "french": "Piochez un sort de dégâts. Il devient <b>Explosif</b>.",
        "german": "Ziehe einen Schadenszauber. Er wird <b>Explosiv</b>.",
        "russian": "Возьмите заклинание, наносящее урон. Оно становится <b>Взрывной</b>.",
        "portuguese": "Compre um feitiço de dano. Ele se torna <b>Explosivo</b>.",
        "chinese": "抽取一张伤害法术。它获得<b>爆炸</b>。",
        "spanish": "Roba un hechizo de daño. Se vuelve <b>Explosivo</b>.",
        "chinese_traditional": "抽取一張傷害法術。它獲得<b>爆炸</b>。",
        "korean": "피해 주문을 뽑음. 해당 주문은 <b>폭발</b> 획득.",
        "japanese": "ダメージ呪文を引く。その呪文は<b>爆発</b>になる。"
      },
      "rarity": "common",
      "card_art": "@HedgeConjurer",
      "is_an_ability": true,
      "cooldown": 5,
      "initial_cooldown": 4,
      "targetless": true,
      "card_type": "spell",
