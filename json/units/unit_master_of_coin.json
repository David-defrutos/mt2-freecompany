{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnMasterOfCoin",
      "names": {
        "english": "Master of Coin"
      },
      "card_art": "@MasterOfCoin",
      "cost": 1,
      "card_type": "monster",
      "rarity": "rare",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnMasterOfCoinEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Keeps the ledger. Keeps the difference."
        }
      ],
      "pools": [
        "UnitsAllBanner"
      ]
    }
  ],
  "characters": [
    {
      "id": "MasterOfCoin",
      "names": {
        "english": "Master of Coin"
      },
      "character_art": "@MasterOfCoinCharacterArt",
      "size": 1,
      "attack_damage": 10,
      "health": 18,
      "subtypes": [
        "SubtypesData_BannerUnit",
        "@Sub_Melee",
        "@Sub_Rogue",
        "@Sub_Goblin"
      ],
      "starting_status_effects": [
        {
          "status": "avarice",
          "count": 3
        }
      ],
      "room_modifiers": [
        "@MasterOfCoinGoldAttack"
      ],
      "triggers": [
        {
          "id": "@MasterOfCoinAvariceTrigger"
        },
        {
          "id": "@MasterOfCoinCelebrate"
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnMasterOfCoinEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@MasterOfCoin"
    },
    {
      "id": "MasterOfCoinAvariceGain",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "room",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "avarice",
          "count": 1
        }
      ]
    },
    {
      "id": "MasterOfCoinCelebrateGain",
      "name": "CardEffectAddCardUpgradeToUnits",
      "target_mode": "self",
      "target_team": "monsters",
      "param_upgrade": "@MasterOfCoinCelebrateUpgrade",
      "param_int_3": 2
    }
  ],
  "room_modifiers": [
    {
      "id": "MasterOfCoinGoldAttack",
      "name": "RoomStateSelfDamagePerGoldModifier",
      "descriptions": {
        "english": "+[power][attack] per [secondarypower][coin] you started the turn with."
      },
      "param_int": 5,
      "param_int_2": 100
    }
  ],
  "sprites": [
    {
      "id": "MasterOfCoin",
      "path": "textures/MasterOfCoinCardArt.png"
    },
    {
      "id": "MasterOfCoinCharacterArt",
      "path": "textures/MasterOfCoinCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "MasterOfCoin",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@MasterOfCoin"
        }
      }
    },
    {
      "id": "MasterOfCoinCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@MasterOfCoinCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 0.505,
              "z": 0
            },
            "scale": {
              "x": 0.641,
              "y": 0.641,
              "z": 1
            }
          }
        }
      }
    }
  ],
  "character_triggers": [
    {
      "id": "MasterOfCoinAvariceTrigger",
      "trigger": "on_team_turn_begin",
      "descriptions": {
        "english": "Apply <b>1</b> [avarice] to all friendly units in this room."
      },
      "effects": [
        "@MasterOfCoinAvariceGain"
      ]
    },
    {
      "id": "MasterOfCoinCelebrate",
      "trigger": "on_encounter_complete",
      "descriptions": {
        "english": "Gain <b>2</b> [avarice] permanently."
      },
      "effects": [
        "@MasterOfCoinCelebrateGain"
      ]
    }
  ],
  "upgrades": [
    {
      "id": "MasterOfCoinCelebrateUpgrade",
      "status_effect_upgrades": [
        {
          "status": "avarice",
          "count": 2
        }
      ]
    }
  ]
}
