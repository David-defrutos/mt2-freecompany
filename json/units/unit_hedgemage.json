{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnHedgeMage",
      "names": {
        "english": "Hedge-Mage"
      },
      "card_art": "@HedgeMage",
      "cost": 2,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnHedgeMageEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Self-taught. It shows, but it works."
        }
      ],
      "pools": [
        "UnitsAllBanner"
      ]
    },
    {
      "id": "HedgeMageVolley",
      "names": {
        "english": "Arcane Volley"
      },
      "descriptions": {
        "english": "Deal <b>2</b> damage per [mt2_freecompany.Plugin_arcane_charge] to <b>3</b> random enemies on this floor, then lose all [mt2_freecompany.Plugin_arcane_charge]."
      },
      "rarity": "common",
      "card_art": "@HedgeMage",
      "is_an_ability": true,
      "cooldown": 1,
      "targetless": true,
      "card_type": "spell",
      "effects": [
        "@HedgeMageVolleyGate",
        "@HedgeMageBolt1",
        "@HedgeMageBolt2",
        "@HedgeMageBolt3",
        "@HedgeMageSpend"
      ],
      "initial_keyboard_target": "front_friendly"
    }
  ],
  "characters": [
    {
      "id": "HedgeMage",
      "names": {
        "english": "Hedge-Mage"
      },
      "character_art": "@HedgeMageCharacterArt",
      "size": 1,
      "attack_damage": 4,
      "health": 14,
      "subtypes": [
        "SubtypesData_BannerUnit",
        "@Sub_Ranged",
        "@Sub_Wizard",
        "@Sub_Goblin"
      ],
      "triggers": [
        {
          "id": "@HedgeMageSpellTrigger"
        }
      ],
      "ability": "@HedgeMageVolley"
    }
  ],
  "effects": [
    {
      "id": "SpawnHedgeMageEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@HedgeMage"
    },
    {
      "id": "HedgeMageVolleyGate",
      "name": {
        "id": "@CardEffectRequireStatusThreshold",
        "mod_reference": "Conductor"
      },
      "target_mode": "self",
      "target_team": "monsters",
      "param_bool": true,
      "param_status_effects": [
        {
          "status": "@arcane_charge",
          "count": 1
        }
      ],
      "should_fail_to_cast_if_test_fails": true,
      "should_cancel_subsequent_effects_if_test_fails": true
    },
    {
      "id": "HedgeMageBolt1",
      "name": "CardEffectDamage",
      "target_mode": "random_in_room",
      "target_team": "heroes",
      "param_int": 2,
      "use_status_effect_multiplier": true,
      "status_effect_multiplier": "@arcane_charge"
    },
    {
      "id": "HedgeMageBolt2",
      "name": "CardEffectDamage",
      "target_mode": "random_in_room",
      "target_team": "heroes",
      "param_int": 2,
      "use_status_effect_multiplier": true,
      "status_effect_multiplier": "@arcane_charge"
    },
    {
      "id": "HedgeMageBolt3",
      "name": "CardEffectDamage",
      "target_mode": "random_in_room",
      "target_team": "heroes",
      "param_int": 2,
      "use_status_effect_multiplier": true,
      "status_effect_multiplier": "@arcane_charge"
    },
    {
      "id": "HedgeMageSpend",
      "name": "CardEffectRemoveStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "@arcane_charge",
          "count": 99
        }
      ]
    },
    {
      "id": "HedgeMageGainCharge",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "@arcane_charge",
          "count": 1
        }
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "HedgeMageSpellTrigger",
      "trigger": "card_spell_played",
      "descriptions": {
        "english": "Gain <b>[effect0.status0.power]</b> [mt2_freecompany.Plugin_arcane_charge]."
      },
      "effects": [
        "@HedgeMageGainCharge"
      ]
    }
  ],
  "sprites": [
    {
      "id": "HedgeMage",
      "path": "textures/HedgeMageCardArt.png"
    },
    {
      "id": "HedgeMageCharacterArt",
      "path": "textures/HedgeMageCharacterArt.png"
    },
    {
      "id": "StatusArcaneCharge",
      "path": "textures/StatusArcaneCharge.png"
    }
  ],
  "game_objects": [
    {
      "id": "HedgeMage",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@HedgeMage"
        }
      }
    },
    {
      "id": "HedgeMageCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@HedgeMageCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 0.427,
              "z": 0
            },
            "scale": {
              "x": 0.687,
              "y": 0.687,
              "z": 1
            }
          }
        }
      }
    }
  ],
  "status_effects": [
    {
      "id": "arcane_charge",
      "class_name": "@StatusEffectFreeCompanyCountdownState",
      "names": {
        "english": "Arcane Charge"
      },
      "stackable_names": {
        "english": "<nobr>Arcane Charge {0}</nobr>"
      },
      "card_tooltips": {
        "english": "Stored power for Arcane Volley."
      },
      "character_tooltips": {
        "english": "Stored power for Arcane Volley."
      },
      "replacement_texts": {
        "english": "<b>Arcane Charge</b>"
      },
      "notifications": {
        "english": "Arcane Charge"
      },
      "display_category": "positive",
      "trigger_stage": "none",
      "is_stackable": true,
      "remove_stack_at_end_of_turn": false,
      "param_int": 0,
      "icon": "@StatusArcaneCharge"
    }
  ],
  "atlas_icons": [
    {
      "id": "StatusArcaneCharge",
      "path": "textures/StatusArcaneCharge.png"
    }
  ]
}