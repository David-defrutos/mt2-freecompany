      ],
      "lore_tooltips": [
        {
          "english": "Self-taught. It shows, but it works.",
          "french": "Autodidacte. Ça se montre, mais ça marche.",
          "german": "Ich habe mich selbst gelehrt. Es zeigt sich, aber es funktioniert.",
          "russian": "Самоученный. Появляется, но работает.",
          "portuguese": "Autodidacta. Aparece, mas funciona.",
          "chinese": "他自学. 它显示,但它工作.",
          "spanish": "Autodidacta. Se nota, pero funciona.",
          "chinese_traditional": "他是自學的. 顯示,但它有效.",
          "korean": "자기 교육자. 보이지만 효과가 있어요",
          "japanese": "自分で教えた 見えますが 効果があります"
        }
      ],
      "pools": [
        "UnitsAllBanner"
      ]
    },
    {
      "id": "HedgeMageVolley",
      "names": {
        "english": "Arcane Volley",
        "french": "Salve arcanique",
        "german": "Arkane Salve",
        "russian": "Чародейский залп",
        "portuguese": "Salva Arcana",
        "chinese": "奥术齐射",
        "spanish": "Andanada arcana",
        "chinese_traditional": "奧術齊射",
        "korean": "비전 일제 사격",
        "japanese": "秘術の一斉射撃"
      },
      "descriptions": {
        "english": "Deal <b>2</b> damage per [mt2_freecompany.Plugin_arcane_charge] to <b>3</b> random enemies on this floor, then lose all [mt2_freecompany.Plugin_arcane_charge].",
        "french": "Inflige <b>2</b> dégâts par [mt2_freecompany.Plugin_arcane_charge] à <b>3</b> ennemis aléatoires de cet étage, puis perd toutes ses [mt2_freecompany.Plugin_arcane_charge].",
        "german": "Fügt <b>3</b> zufälligen Gegnern auf diesem Stockwerk pro [mt2_freecompany.Plugin_arcane_charge] <b>2</b> Schaden zu. Verliert danach alle [mt2_freecompany.Plugin_arcane_charge].",
        "russian": "Наносит <b>3</b> случайным врагам на этом этаже по <b>2</b> урона за каждый [mt2_freecompany.Plugin_arcane_charge], затем теряет все [mt2_freecompany.Plugin_arcane_charge].",
        "portuguese": "Causa <b>2</b> de dano por [mt2_freecompany.Plugin_arcane_charge] a <b>3</b> inimigos aleatórios neste andar e depois perde todas as [mt2_freecompany.Plugin_arcane_charge].",
        "chinese": "对本层<b>3</b>个随机敌人造成伤害，每层[mt2_freecompany.Plugin_arcane_charge]造成<b>2</b>点伤害，然后失去全部[mt2_freecompany.Plugin_arcane_charge]。",
        "spanish": "Inflige <b>2</b> de daño por [mt2_freecompany.Plugin_arcane_charge] a <b>3</b> enemigos aleatorios de este piso y luego pierde todas las [mt2_freecompany.Plugin_arcane_charge].",
        "chinese_traditional": "對本層<b>3</b>個隨機敵人造成傷害，每層[mt2_freecompany.Plugin_arcane_charge]造成<b>2</b>點傷害，然後失去全部[mt2_freecompany.Plugin_arcane_charge]。",
        "korean": "이 층의 무작위 적 <b>3</b>명에게 [mt2_freecompany.Plugin_arcane_charge] 중첩당 <b>2</b> 피해를 가한 뒤 모든 [mt2_freecompany.Plugin_arcane_charge] 상실.",
        "japanese": "この階のランダムな敵<b>3</b>体に[mt2_freecompany.Plugin_arcane_charge]1スタックにつき<b>2</b>ダメージを与え、その後すべての[mt2_freecompany.Plugin_arcane_charge]を失う。"
      },
      "rarity": "common",
