{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnFreeLance",
      "names": {
        "english": "Free Lance"
      },
      "card_art": "@FreeLance",
      "cost": 1,
      "card_type": "monster",
      "rarity": "common",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnFreeLanceEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Cheapest steel that still holds a line."
        }
      ]
    }
  ],
  "characters": [
    {
      "id": "FreeLance",
      "names": {
        "english": "Free Lance"
      },
      "character_art": "@FreeLanceCharacterArt",
      "size": 1,
      "attack_damage": 4,
      "health": 12,
      "subtypes": [
        "@Sub_Melee",
        "@Sub_Warrior",
        "@Sub_Goblin"
      ],
      "triggers": [
        {
          "id": "@FreeLanceTrigger"
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnFreeLanceEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@FreeLance"
    },
    {
      "id": "FreeLanceAbility",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "armor",
          "count": 3
        }
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "FreeLanceTrigger",
      "trigger": "on_spawn",
      "descriptions": {
        "english": "Apply <b>3</b> [armor] to itself."
      },
      "effects": [
        "@FreeLanceAbility"
      ]
    }
  ],
  "sprites": [
    {
      "id": "FreeLance",
      "path": "textures/FreeLanceCardArt.png"
    },
    {
      "id": "FreeLanceCharacterArt",
      "path": "textures/FreeLanceCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "FreeLance",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@FreeLance"
        }
      }
    },
    {
      "id": "FreeLanceCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@FreeLanceCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 0.924,
              "z": 0
            },
            "scale": {
              "x": 0.82,
              "y": 0.82,
              "z": 1
            }
          }
        }
      }
    }
  ]
}
