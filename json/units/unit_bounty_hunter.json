{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnBountyHunter",
      "names": {
        "english": "Bounty Hunter"
      },
      "card_art": "@BountyHunter",
      "cost": 2,
      "card_type": "monster",
      "rarity": "rare",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnBountyHunterEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Names on a list. Coin per name."
        }
      ],
      "pools": [
        "MegaPool"
      ]
    },
    {
      "id": "BountyHunterShot",
      "names": {
        "english": "Claim the Bounty"
      },
      "descriptions": {
        "english": "Attack an enemy unit of your choice on any floor."
      },
      "card_art": "@BountyHunter",
      "is_an_ability": true,
      "cooldown": 1,
      "initial_cooldown": 1,
      "targetless": false,
      "targets_room": true,
      "can_ability_target_other_floors": true,
      "card_type": "spell",
      "effects": [
        "@BountyHunterShotAttack"
      ]
    }
  ],
  "characters": [
    {
      "id": "BountyHunter",
      "names": {
        "english": "Bounty Hunter"
      },
      "character_art": "@BountyHunterCharacterArt",
      "size": 1,
      "attack_damage": 7,
      "health": 16,
      "subtypes": [
        "@Sub_Ranged",
        "@Sub_Ranger",
        "@Sub_Goblin"
      ],
      "triggers": [
        {
          "id": "@BountyHunterTrigger"
        },
        {
          "id": "@BountyHunterPreAbility"
        },
        {
          "id": "@BountyHunterAfterAbility"
        }
      ],
      "starting_status_effects": [
        {
          "status": "ambush",
          "count": 1
        }
      ],
      "ability": "@BountyHunterShot"
    }
  ],
  "effects": [
    {
      "id": "SpawnBountyHunterEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@BountyHunter"
    },
    {
      "id": "BountyHunterShotAttack",
      "name": "CardEffectAttackTargetsWithSelfUnit",
      "target_mode": "drop_target_character",
      "target_team": "heroes"
    },
    {
      "id": "BountyHunterCooldown",
      "name": "@CardEffectRefreshAbilityOnKill",
      "target_mode": "self",
      "target_team": "monsters",
      "param_int": 1
    },
    {
      "id": "BountyHunterMarkAbility",
      "name": "@CardEffectRefreshAbilityOnKill",
      "target_mode": "self",
      "target_team": "monsters",
      "param_int": 0
    },
    {
      "id": "BountyHunterRefreshAbility",
      "name": "@CardEffectRefreshAbilityOnKill",
      "target_mode": "self",
      "target_team": "monsters",
      "param_int": 2
    },
    {
      "id": "BountyHunterGold",
      "name": "CardEffectRewardGold",
      "target_mode": "self",
      "target_team": "monsters",
      "param_int": 5
    }
  ],
  "character_triggers": [
    {
      "id": "BountyHunterTrigger",
      "trigger": "on_kill",
      "descriptions": {
        "english": "Its ability is ready again. Gain [effect1.power] [coin]."
      },
      "effects": [
        "@BountyHunterCooldown",
        "@BountyHunterGold"
      ]
    },
    {
      "id": "BountyHunterPreAbility",
      "trigger": "on_pre_own_ability_activated",
      "hide_visual_and_ignore_silence": true,
      "effects": [
        "@BountyHunterMarkAbility"
      ]
    },
    {
      "id": "BountyHunterAfterAbility",
      "trigger": "on_own_ability_activated",
      "hide_visual_and_ignore_silence": true,
      "effects": [
        "@BountyHunterRefreshAbility"
      ]
    }
  ],
  "sprites": [
    {
      "id": "BountyHunter",
      "path": "textures/BountyHunterCardArt.png"
    },
    {
      "id": "BountyHunterCharacterArt",
      "path": "textures/BountyHunterCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "BountyHunter",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@BountyHunter"
        }
      }
    },
    {
      "id": "BountyHunterCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@BountyHunterCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 0.524,
              "z": 0
            },
            "scale": {
              "x": 0.733,
              "y": 0.733,
              "z": 1
            }
          }
        }
      }
    }
  ]
}
