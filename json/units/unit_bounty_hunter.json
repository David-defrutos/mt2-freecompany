{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnBountyHunter",
      "names": {
        "english": "Bounty Hunter"
      },
      "card_art": "@BountyHunter",
      "cost": 1,
      "card_type": "monster",
      "rarity": "rare",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnBountyHunterEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Names on a list. Coin per name."
        }
      ],
      "pools": [
        "MegaPool"
      ]
    }
  ],
  "characters": [
    {
      "id": "BountyHunter",
      "names": {
        "english": "Bounty Hunter"
      },
      "character_art": "@BountyHunterCharacterArt",
      "size": 1,
      "attack_damage": 7,
      "health": 16,
      "subtypes": [
        "@Sub_Ranged",
        "@Sub_Ranger"
      ],
      "triggers": [
        {
          "id": "@BountyHunterTrigger"
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnBountyHunterEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@BountyHunter"
    },
    {
      "id": "BountyHunterAbility",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "avarice",
          "count": 3
        }
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "BountyHunterTrigger",
      "trigger": "on_kill",
      "descriptions": {
        "english": "Gain <b>3</b> [avarice]."
      },
      "effects": [
        "@BountyHunterAbility"
      ]
    }
  ],
  "sprites": [
    {
      "id": "BountyHunter",
      "path": "textures/BountyHunterCardArt.png"
    },
    {
      "id": "BountyHunterCharacterArt",
      "path": "textures/BountyHunterCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "BountyHunter",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@BountyHunter"
        }
      }
    },
    {
      "id": "BountyHunterCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@BountyHunterCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 0.524,
              "z": 0
            },
            "scale": {
              "x": 0.733,
              "y": 0.733,
              "z": 1
            }
          }
        }
      }
    }
  ]
}
