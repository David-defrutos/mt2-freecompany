{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnIronboundChampion",
      "names": {
        "english": "Ironbound Champion"
      },
      "card_art": "@IronboundChampion",
      "cost": 2,
      "card_type": "monster",
      "rarity": "rare",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnIronboundChampionEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Paid double. Worth triple."
        }
      ],
      "pools": [
        "UnitsAllBanner"
      ]
    },
    {
      "id": "IronboundChampionAbility",
      "names": {
        "english": "Ironbound Oath"
      },
      "descriptions": {
        "english": "Apply <b>2</b> [damageshield] and <b>20</b> [armor] to itself."
      },
      "card_art": "@IronboundChampion",
      "is_an_ability": true,
      "cooldown": 3,
      "initial_cooldown": 3,
      "targetless": true,
      "targets_room": false,
      "card_type": "spell",
      "effects": [
        "@IronboundChampionAbilityGuard",
        "@IronboundChampionAbilityArmor"
      ]
    }
  ],
  "characters": [
    {
      "id": "IronboundChampion",
      "names": {
        "english": "Ironbound Champion"
      },
      "character_art": "@IronboundChampionCharacterArt",
      "size": 1,
      "attack_damage": 10,
      "health": 40,
      "subtypes": [
        "SubtypesData_BannerUnit",
        "@Sub_Melee",
        "@Sub_Warrior",
        "@Sub_Goblin"
      ],
      "triggers": [
        {
          "id": "@IronboundChampionTrigger"
        }
      ],
      "ability": "@IronboundChampionAbility"
    }
  ],
  "effects": [
    {
      "id": "SpawnIronboundChampionEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@IronboundChampion"
    },
    {
      "id": "IronboundChampionArmor",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "room",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "armor",
          "count": 10
        }
      ]
    },
    {
      "id": "IronboundChampionAbilityGuard",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "damage shield",
          "count": 2
        }
      ]
    },
    {
      "id": "IronboundChampionAbilityArmor",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "armor",
          "count": 20
        }
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "IronboundChampionTrigger",
      "trigger": "on_spawn",
      "descriptions": {
        "english": "Apply <b>10</b> [armor] to all friendly units in this room."
      },
      "effects": [
        "@IronboundChampionArmor"
      ]
    }
  ],
  "sprites": [
    {
      "id": "IronboundChampion",
      "path": "textures/IronboundChampionCardArt.png"
    },
    {
      "id": "IronboundChampionCharacterArt",
      "path": "textures/IronboundChampionCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "IronboundChampion",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@IronboundChampion"
        }
      }
    },
    {
      "id": "IronboundChampionCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@IronboundChampionCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 0.468,
              "z": 0
            },
            "scale": {
              "x": 0.683,
              "y": 0.683,
              "z": 1
            }
          }
        }
      }
    }
