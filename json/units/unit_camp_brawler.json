{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnCampBrawler",
      "names": {
        "english": "Camp Brawler"
      },
      "card_art": "@CampBrawler",
      "cost": 1,
      "card_type": "monster",
      "rarity": "common",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnCampBrawlerEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Fights for the company. Also fights the company."
        }
      ]
    }
  ],
  "characters": [
    {
      "id": "CampBrawler",
      "names": {
        "english": "Camp Brawler"
      },
      "character_art": "@CampBrawlerCharacterArt",
      "size": 1,
      "attack_damage": 7,
      "health": 6,
      "subtypes": [
        "@Sub_Melee",
        "@Sub_Barbarian",
        "@Sub_Goblin"
      ],
      "triggers": [
        {
          "id": "@CampBrawlerTrigger"
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnCampBrawlerEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@CampBrawler"
    },
    {
      "id": "CampBrawlerAbility",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "buff",
          "count": 2
        }
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "CampBrawlerTrigger",
      "trigger": "on_kill",
      "descriptions": {
        "english": "Gain <b>2</b> [buff]."
      },
      "effects": [
        "@CampBrawlerAbility"
      ]
    }
  ],
  "sprites": [
    {
      "id": "CampBrawler",
      "path": "textures/CampBrawlerCardArt.png"
    },
    {
      "id": "CampBrawlerCharacterArt",
      "path": "textures/CampBrawlerCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "CampBrawler",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@CampBrawler"
        }
      }
    },
    {
      "id": "CampBrawlerCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@CampBrawlerCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 0.541,
              "z": 0
            },
            "scale": {
              "x": 0.633,
              "y": 0.633,
              "z": 1
            }
          }
        }
      }
    }
  ]
}
