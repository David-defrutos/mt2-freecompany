{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnCampBrawler",
      "names": {
        "english": "Camp Brawler",
        "french": "Bagarreur du camp",
        "german": "Lagerraufbold",
        "russian": "Лагерный забияка",
        "portuguese": "Brigão do Acampamento",
        "chinese": "营地斗士",
        "spanish": "Camorrista del campamento",
        "chinese_traditional": "營地鬥士",
        "korean": "야영지 싸움꾼",
        "japanese": "野営地の喧嘩屋"
      },
      "card_art": "@CampBrawler",
      "cost": 1,
      "card_type": "monster",
      "rarity": "common",
      "class": "@ClassFreeCompany",
      "targets_room": true,
      "targetless": false,
      "effects": [
        "@SpawnCampBrawlerEffect"
      ],
      "lore_tooltips": [
        {
          "english": "Fights for the company. Also fights the company.",
