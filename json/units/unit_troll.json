  "character_triggers": [
    {
      "id": "TrollBeastmasterSpawn",
      "trigger": "on_spawn",
      "descriptions": {
        "english": "If a <b>Beastmaster</b> is in play on any floor, this unit enters stronger for the rest of combat."
      },
      "effects": [
        "@TrollBeast1",
        "@TrollBeast2",
        "@TrollBeast3"
      ]
    },
    {
      "id": "TrollBeastmasterCelebrate",
      "trigger": "on_encounter_complete",
      "descriptions": {
        "english": "If a <b>Beastmaster</b> is alive on any floor, this unit permanently gains [attack] and [health]."
      },
      "effects": [
        "@TrollCeleb2",
        "@TrollCeleb3"
      ]
    },
    {
      "id": "BogTrollStrike",
      "trigger": "on_attacking",
      "descriptions": {
        "english": "Apply <b>1</b> [rooted] to the unit it attacks."
      },
      "effects": [
        "@BogTrollRoot"
      ]
    }
