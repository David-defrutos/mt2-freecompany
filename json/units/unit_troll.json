  "character_triggers": [
    {
      "id": "TrollBeastmasterSpawn",
      "trigger": "on_spawn",
      "descriptions": {
        "english": "If <b>Beastmaster</b> Vesper is in play, gain +<b>10</b> [attack] and [health] for each Ring after the first. <b>Beastmaster II</b> or higher: also gain [trample].",
        "french": "Si Vesper <b>Maître des bêtes</b> est en jeu, gagne +<b>10</b> [attack] et [health] par cercle après le premier. <b>Maître des bêtes II</b> ou plus : gagne aussi [trample].",
        "german": "Wenn Vesper <b>Bestienmeister</b> im Spiel ist, erhält diese Einheit ab dem zweiten Ring pro Ring +<b>10</b> [attack] und [health]. <b>Bestienmeister II</b> oder höher: erhält auch [trample].",
        "russian": "Если Vesper <b>Повелитель зверей</b> в игре, получает +<b>10</b> [attack] и [health] за каждый круг после первого. <b>Повелитель зверей II</b> или выше: также получает [trample].",
        "portuguese": "Se Vesper <b>Mestre das Feras</b> estiver em jogo, ganha +<b>10</b> [attack] e [health] por anel após o primeiro. <b>Mestre das Feras II</b> ou superior: também ganha [trample].",
        "chinese": "若<b>驯兽师</b> Vesper在场，则第一环之后每环获得+<b>10</b> [attack]和[health]。<b>驯兽师 II</b>或更高等级：同时获得[trample]。",
        "spanish": "Si Vesper <b>Maestro de bestias</b> está en juego, gana +<b>10</b> [attack] y [health] por cada anillo después del primero. <b>Maestro de bestias II</b> o superior: también gana [trample].",
        "chinese_traditional": "若<b>馴獸師</b> Vesper在場，則第一環之後每環獲得+<b>10</b> [attack]和[health]。<b>馴獸師 II</b>或更高等級：同時獲得[trample]。",
        "korean": "<b>야수 조련사</b> Vesper가 전장에 있으면 첫 고리 이후 고리마다 +<b>10</b> [attack] 및 [health] 획득. <b>야수 조련사 II</b> 이상이면 [trample]도 획득.",
        "japanese": "<b>獣使い</b> Vesperが場にいる場合、第1リング以降のリング1つにつき+<b>10</b> [attack]と[health]を得る。<b>獣使い II</b>以上なら[trample]も得る。"
      },
      "effects": [
        "@TrollRingBonus",
        "@TrollBeast2",
        "@TrollBeast3"
      ]
    },
    {
      "id": "BogTrollStrike",
      "trigger": "on_attacking",
      "descriptions": {
        "english": "Apply [effect0.status0.power] [rooted] to the unit it attacks.",
        "french": "Applique [effect0.status0.power] [rooted] à l’unité qu’elle attaque.",
        "german": "Verleiht der angegriffenen Einheit [effect0.status0.power] [rooted].",
        "russian": "Накладывает [effect0.status0.power] [rooted] на атакуемую боевую единицу.",
        "portuguese": "Aplica [effect0.status0.power] [rooted] à unidade que ataca.",
        "chinese": "对其攻击的单位施加[effect0.status0.power] [rooted]。",
        "spanish": "Aplica [effect0.status0.power] [rooted] a la unidad a la que ataca.",
        "chinese_traditional": "對其攻擊的單位施加[effect0.status0.power] [rooted]。",
        "korean": "공격한 유닛에게 [effect0.status0.power] [rooted] 부여.",
        "japanese": "攻撃対象のユニットに[effect0.status0.power] [rooted]を付与。"
      },
      "effects": [
        "@BogTrollRoot"
      ]
    }
  ],
